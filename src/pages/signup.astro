---
let message = "";

if (Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const email = data.get("email");
        const password = data.get("password");

        // ডাটাবেসে ডাটা পাঠানো হচ্ছে
        const stmt = Astro.locals.runtime.env.DB.prepare(
            "INSERT INTO users (id, email, password) VALUES (?, ?, ?)"
        );
        
        await stmt.bind(crypto.randomUUID(), email, password).run();
        
        message = "সফলভাবে সাইন-আপ হয়েছে!";
    } catch (e) {
        console.error("Signup Error:", e);
        message = "এরর: ডাটা সেভ হয়নি।";
    }
}
---

<html lang="en">
<body class="bg-gray-50 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md w-96">
        <h2 class="text-2xl font-bold mb-6">সাইন আপ</h2>
        {message && <p class="mb-4 text-green-600 font-semibold">{message}</p>}
        <form method="POST" class="space-y-4">
            <input type="email" name="email" placeholder="ইমেইল" required class="w-full p-2 border rounded" />
            <input type="password" name="password" placeholder="পাসওয়ার্ড" required class="w-full p-2 border rounded" />
            <button type="submit" class="w-full bg-blue-600 text-white p-2 rounded hover:bg-blue-700">জমা দিন</button>
        </form>
    </div>
</body>
</html>
