---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Fly Trip Visa">
  <div class="flex flex-col items-center justify-center gap-4 py-20 px-8">
    <h1 class="text-5xl font-bold">FlyTripVisa 😈 Admin</h1>
    <p class="text-xl text-muted-foreground text-center">Manage a SaaS application - customers, subscriptions - using Cloudflare Workers and D1.</p>
    
    <div class="flex gap-4 mt-4">
      <a class="px-6 py-2 bg-black text-white rounded" href="/admin">
        Go to admin
      </a>
      <a class="px-6 py-2 border border-black rounded" href="https://github.com/cloudflare/templates/tree/main/saas-admin-template" target="_blank">
        View on GitHub
      </a>
    </div>
  </div>
</Layout>
