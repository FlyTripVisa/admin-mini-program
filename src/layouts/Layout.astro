  ---
const { title = "Fly Trip Visa" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/globals.css">
</head>
<body>
  <div id="__nuxt">
    <div class="wrap">
      <div class="main-content">
        
        <!-- HEADER: LOCKED & PERMANENT -->
        <div class="banner">
          <div class="banner__inner"></div>
          <div class="header-top">
            <div class="header-left-logo">
              <img src="https://raw.githubusercontent.com/FlyTripVisa/miniprogram/refs/heads/main/Img/Black%20Dragon%20Flat%20Illustrative%20E-Sports%20Gaming%20Logo.png" alt="Logo">
            </div>
            <div class="lang_change">
              <button class="lang-switcher__trigger" id="dropdown_btn"><span>🌐 ▾</span></button>
              <div class="dropdown-menu" id="dropdown_menu">
                  <a href="https://flytripvisa.site/visa" target="_blank">Visa Newsroom</a>
                  <a href="https://flytripvisa.site/ai-support" target="_blank">AI Support Center</a>
                  <a href="https://flytripvisa.site/jingpay" target="_blank">Jingpay Virtual Card</a>
                  <a href="https://flytripvisa.site/esim" target="_blank">Fly-eSim Deals</a>
                  <a href="https://flytripvisa.site/flights" target="_blank">Flights</a>
                  <a href="https://flytripvisa.site/hotels" target="_blank">Hotels Deals</a>
                  <a href="https://flytripvisa.site/business-setup" target="_blank">China Business & Residency</a>
                </div>
            </div>
          </div>
          <div class="banner__bd">
            <div class="banner__desc_wrap">
              <h1 class="banner__desc">Fly Trip Visa | 飞行旅行签证 <span class="badge-gold">✓</span></h1>
              <p class="banner__subdesc">AI-Powered Online Visa Application Assistant and online visa application simplified</p>
            </div>
          </div>
        </div>

        <!-- MAIN PAGE CONTENT -->
        <main>
          <slot />
        </main>

        <!-- FOOTER: LOCKED & PERMANENT -->
        <div class="footer-wrp">
          <div class="footer">
            <h2 class="banner__desc">Fly Trip Visa | 飞行旅行签证<span class="badge-gold">✓</span></h2>
            <div style="max-width: 600px; margin: 10px auto; color: #ffffffe6; font-size: 14px; text-align: center;">
              <p>Fly Trip Visa provides professional consulting for <strong>business setup</strong>, <strong>freelance visas</strong>, and <strong>residency ID</strong> processing.</p>
            </div>
            
            <h5 class="banner__desc" style="margin-top: 15px;">Social & App Support</h5>
            <div class="footer-download" style="margin-top: 15px; margin-bottom: 25px;">
              <a class="footer-download-item" href="https://www.facebook.com/share/18xnYKPgnc/" target="_blank"><i class="icon-fb"></i></a>
              <a class="footer-download-item" href="https://t.me/FlytripvisaBot" target="_blank"><i class="icon-tg"></i></a>
            </div>

            <div class="footer__bd">
              <div class="footer__links">
                <a href="https://flytripvisa.site/contact.html" target="_blank">Contact Us</a> |
                <a href="https://flytripvisa.site/terms">Terms</a> |
                <a href="https://flytripvisa.site/privacy">Privacy</a>
              </div>
              <div class="footer__copyright">Copyright © 2012-2026 Fly Trip Visa | 飞行旅行签证 . All Rights Reserved.</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
</html>

